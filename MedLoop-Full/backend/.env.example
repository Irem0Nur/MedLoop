# MedLoop Backend - Ortam değişkenleri örneği
# Yerel geliştirme için: bu dosyayı ".env" olarak kopyala ve değerleri düzenle.
# Production'da (Render, Docker, vs.) bu değişkenleri platformun kendi
# environment variable ayarlarından tanımla; .env dosyasını asla commit'leme.

# --- Veritabanı ---
# Boş bırakılırsa proje klasöründe bir SQLite dosyasına (medloop_dev.db)
# otomatik düşer (sadece geliştirme için uygundur).
# Production'da PostgreSQL kullan, örnek:
#   DATABASE_URL=postgresql://medloop_user:sifre@localhost:5432/medloop
DATABASE_URL=

# --- JWT / Auth ---
# Production'da mutlaka uzun/rastgele bir değerle değiştir, örn:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-degistir-bunu
JWT_ACCESS_TOKEN_EXPIRES_DAYS=30

# --- İş kuralları ---
# Son kullanma tarihine kaç gün kala "yaklaşıyor" bildirimi gönderilsin
EXPIRY_WARNING_DAYS_BEFORE=7
# Eczaneye teslim edilen ilaç başına kazanılan puan
POINTS_PER_DELIVERY=10

# --- Zamanlanmış görev (SKT kontrolü) ---
# Her gün saat kaçta çalışsın (sunucu saat dilimine göre, 24 saat formatı)
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
# Testte zamanlayıcıyı tamamen kapatmak için "false" yap
ENABLE_SCHEDULER=true

# --- Firebase Cloud Messaging (push notification) ---
# Firebase projen hazır olduğunda service account JSON dosyasının
# (Firebase Console > Project Settings > Service Accounts > Generate new
# private key) sunucudaki yolunu buraya yaz. Boş bırakılırsa push
# gönderimi sessizce devre dışı kalır, uygulama içi bildirimler etkilenmez.
FIREBASE_CREDENTIALS_PATH=

# --- E-posta (SMTP) - "Şifremi unuttum" akışı için ---
# Boş bırakılırsa e-posta gönderilmez, sıfırlama kodu sadece sunucu
# konsoluna loglanır (yerel geliştirmede test etmek için yeterli).
# Gmail ile gerçek e-posta göndermek için:
#   1) Google hesabında 2 adımlı doğrulamayı aç
#   2) https://myaccount.google.com/apppasswords adresinden bir
#      "Uygulama Şifresi" oluştur (normal Gmail şifren DEĞİL)
#   3) Aşağıyı doldur:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=senin-adresin@gmail.com
#        SMTP_PASSWORD=<uygulama şifresi>
#        SMTP_FROM=senin-adresin@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Şifre sıfırlama kodunun geçerlilik süresi (dakika)
PASSWORD_RESET_CODE_EXPIRES_MINUTES=15

# --- CORS ---
# Prod'da frontend domain'inle sınırla, örn: https://medloop.app
CORS_ORIGINS=*
